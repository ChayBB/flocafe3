https://qr-staging.test {
    tls internal

    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        -Server
    }

    reverse_proxy api:3000
}

qr-ordering.accesscam.org {
    header {
        >Cache-Control "no-store"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        -Server
    }

    @customerMenu {
        method GET
        path /api/v1/menu /api/v1/table-session/orders
    }
    @customerOrder {
        method POST
        path /api/v1/orders /api/v1/table-qr/session
    }

    handle @customerMenu {
        reverse_proxy api:3000
    }
    handle @customerOrder {
        request_body {
            max_size 64KB
        }
        reverse_proxy api:3000
    }
    handle {
        respond 404
    }
}

order.aiwittaya.com {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        -Server
    }
    # Each deploy publishes into a new /menu-ui/<release>/ folder, so its files never change in place.
    @versionedAssets path /menu-ui/*
    header @versionedAssets >Cache-Control "public, max-age=31536000, immutable"
    @unversioned not path /menu-ui/*
    header @unversioned >Cache-Control "no-store"

    @customerMenu {
        method GET
        path /api/v1/menu /api/v1/table-session/orders
    }
    @customerOrder {
        method POST
        path /api/v1/orders /api/v1/table-qr/session
    }
    @orderingAssets {
        method GET HEAD
        path / /index.html /order.js /styles.css /menu-ui/*
    }

    handle @customerMenu {
        reverse_proxy api:3000
    }
    handle @customerOrder {
        request_body {
            max_size 64KB
        }
        reverse_proxy api:3000
    }
    handle @orderingAssets {
        root * /data/flo-ordering
        @presentation path /menu-ui/*/menu-presentation.json
        handle @presentation {
            file_server
        }
        handle {
            file_server {
                precompressed br gzip
            }
        }
    }
    handle {
        respond 404
    }
}
